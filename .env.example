# Database
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/ev_rental_go

# Session secret — generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-32-char-secret-key

# Customer Portal URL (dev: localhost, prod: real domain)
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000

# Cron job secret — must match Authorization header sent by crontab
# Generate with: openssl rand -base64 32
CRON_SECRET=replace-with-a-random-secret

# Storage provider: "local" (default) or "s3"
STORAGE_PROVIDER=local

# AWS / S3 — only required when STORAGE_PROVIDER=s3
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=your-bucket-name

# Redis (live GPS position cache)
REDIS_URL=redis://localhost:6379

# Stripe (PromptPay payment gateway)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx